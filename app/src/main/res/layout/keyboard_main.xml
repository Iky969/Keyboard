<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/terminal_bg"
    android:paddingStart="3dp"
    android:paddingEnd="3dp"
    android:paddingTop="5dp"
    android:paddingBottom="24dp">

    <!-- TOP TERMINAL BAR (Hardware Keys, Modifiers, Clipboard, Guide & Arrows) -->
    <LinearLayout
        android:id="@+id/terminal_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/key_esc"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="ESC"
            android:textColor="@color/terminal_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_tab"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="TAB"
            android:textColor="@color/terminal_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_ctrl"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="CTRL"
            android:textColor="@color/terminal_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_alt"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="ALT"
            android:textColor="@color/terminal_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />

        <!-- CLIPBOARD PASTE BUTTON -->
        <Button
            android:id="@+id/key_paste"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="📋"
            android:textColor="@color/terminal_green"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:contentDescription="Paste Clipboard"
            android:padding="0dp" />

        <!-- GUIDE BUTTON -->
        <Button
            android:id="@+id/key_guide"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="💡"
            android:textColor="@color/terminal_amber"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:contentDescription="Keyboard Guide"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_up"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="▲"
            android:textColor="@color/terminal_cyan"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_down"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="▼"
            android:textColor="@color/terminal_cyan"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_left"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="◀"
            android:textColor="@color/terminal_cyan"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_right"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:text="▶"
            android:textColor="@color/terminal_cyan"
            android:textSize="15sp"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_fn_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="Fn"
            android:textColor="@color/terminal_purple"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />

        <Button
            android:id="@+id/key_snippets_toggle"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_key_special"
            android:fontFamily="monospace"
            android:text="&gt;_"
            android:textColor="@color/terminal_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:padding="0dp" />
    </LinearLayout>

    <!-- QUICK SNIPPETS BAR (Horizontal scrollable shell shortcuts) -->
    <HorizontalScrollView
        android:id="@+id/snippets_bar"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:scrollbars="none"
        android:visibility="gone"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/snippets_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- TERMINAL GUIDE PANEL -->
    <LinearLayout
        android:id="@+id/guide_panel"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_guide"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginBottom="6dp">

        <!-- Guide Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="⚡ PANDUAN SHORTCUT TERMINAL"
                android:textColor="@color/terminal_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_close_guide"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:fontFamily="monospace"
                android:text="✖ Tutup"
                android:textColor="@color/terminal_red"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Guide Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/guide_btn_ctrl_c"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:background="@drawable/bg_key_special"
                android:fontFamily="monospace"
                android:text="Ctrl+C"
                android:textColor="@color/terminal_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />

            <Button
                android:id="@+id/guide_btn_ctrl_v"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:background="@drawable/bg_key_special"
                android:fontFamily="monospace"
                android:text="📋 Paste"
                android:textColor="@color/terminal_green"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />

            <Button
                android:id="@+id/guide_btn_ctrl_z"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:background="@drawable/bg_key_special"
                android:fontFamily="monospace"
                android:text="Ctrl+Z"
                android:textColor="@color/terminal_amber"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />

            <Button
                android:id="@+id/guide_btn_ctrl_d"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:background="@drawable/bg_key_special"
                android:fontFamily="monospace"
                android:text="Ctrl+D"
                android:textColor="@color/terminal_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />

            <Button
                android:id="@+id/guide_btn_ctrl_l"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_margin="1dp"
                android:background="@drawable/bg_key_special"
                android:fontFamily="monospace"
                android:text="Ctrl+L"
                android:textColor="@color/terminal_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:padding="0dp" />
        </LinearLayout>

        <!-- Guide Body ScrollView -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="false">

            <TextView
                android:id="@+id/guide_text_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/terminal_text_primary"
                android:textSize="11.5sp"
                android:lineSpacingExtra="3dp" />
        </ScrollView>
    </LinearLayout>

    <!-- KEYBOARD LAYERS CONTAINER -->
    <FrameLayout
        android:id="@+id/layers_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- LAYER 1: QWERTY -->
        <include
            android:id="@+id/layer_qwerty"
            layout="@layout/keyboard_layer_qwerty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- LAYER 2: SYMBOLS -->
        <include
            android:id="@+id/layer_symbols"
            layout="@layout/keyboard_layer_symbols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- LAYER 3: FUNCTION KEYS (F1-F12 + NAV) -->
        <include
            android:id="@+id/layer_fn"
            layout="@layout/keyboard_layer_fn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
