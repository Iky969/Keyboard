<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000E676">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#1A4A3C" />
                    <corners android:radius="5dp" />
                    <stroke android:width="1dp" android:color="@color/terminal_green" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#0F2D24" />
                    <corners android:radius="5dp" />
                    <stroke android:width="1.2dp" android:color="@color/terminal_green" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
