<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FF5252">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="#421C22" />
                    <corners android:radius="5dp" />
                    <stroke android:width="1dp" android:color="@color/terminal_red" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#241419" />
                    <corners android:radius="5dp" />
                    <stroke android:width="1dp" android:color="#45232A" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
